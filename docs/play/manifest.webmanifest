{
  "name": "OPD Register — daily entry, offline",
  "short_name": "OPD Register",
  "description": "A daily OPD register for multi-location clinics: month register, dashboard, day-wise statistics, print and Excel — offline, no account.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f6f9",
